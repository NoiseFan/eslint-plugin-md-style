{
  "name": "@md-style/ast",
  "type": "module",
  "version": "0.3.1",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "description": "Extends Markdown AST",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mdast-util-from-markdown": "catalog:dev",
    "mdast-util-gfm": "catalog:dev",
    "micromark": "catalog:dev",
    "micromark-extension-gfm": "catalog:dev",
    "micromark-util-character": "catalog:dev",
    "micromark-util-types": "catalog:dev"
  },
  "devDependencies": {
    "@types/mdast": "catalog:types",
    "@types/unist": "catalog:types"
  }
}
